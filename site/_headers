/
  Content-Security-Policy: default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self' https://raw.githubusercontent.com; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; connect-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cache-Control: no-cache
